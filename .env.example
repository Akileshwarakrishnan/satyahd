# ==============================================================================
# SATYAHD ZERO-TRUST POLICY ENFORCEMENT MIDDLEMAN - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and configure for your environment:
#   cp .env.example .env
#
# Hard Security Rule: NEVER commit .env to public version control!
# ==============================================================================

# --- Server & Network ---
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# --- Model Provider Abstraction ---
# Options: 'meta' (official Meta API), 'mock' (offline deterministic benchmark), 'openai'
DEFAULT_PROVIDER=meta
ALLOW_MOCK=true
MODEL_TIMEOUT_SECONDS=30

# --- Meta AI Model API Configuration ---
# Get API key from dev.meta.ai (or use ALLOW_MOCK=true for offline local testing)
MODEL_API_KEY=your_meta_model_api_key_here
META_API_KEY=your_meta_model_api_key_here
META_API_BASE=https://api.meta.ai/v1

# Standard Meta Model Identifiers
MODEL_NAME=muse-spark-1.3
WONDER_MODEL=muse-wonder-1.0
IMAGE_MODEL=muse-image-1.0
SAM_MODEL=sam-3.1

# --- Alternative / Fallback Providers (Optional) ---
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

AGENT_B_BASE=
AGENT_B_KEY=
AGENT_B_MODEL=muse-glimmer-30b

# --- Cryptographic Security & Audit Ledger ---
# Path to Ed25519 asymmetric private signing key
SIGNING_KEY_PATH=ed25519_key.pem
ANCHOR_DIR=anchors

# Database Path (SQLite with native append-only triggers and continuous hash chain)
DB_PATH=data/satyahd.db

# --- Optional Integrations (Stretch) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
